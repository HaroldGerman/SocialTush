{
  "name": "Lifonk",
  "short_name": "Lifonk",
  "description": "Conecta, comparte momentos y conversa en Lifonk.",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "background_color": "#EFE8E3",
  "theme_color": "#443C68",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "icons": [
    { "src": "/icons/lifonk.svg?v=2", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
