{
  "name": "Lifonk",
  "short_name": "Lifonk",
  "description": "Conecta, comparte momentos y conversa en Lifonk.",
  "start_url": "/feed",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f6fb",
  "theme_color": "#6d28d9",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    { "src": "/icons/lifonk-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/lifonk-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
