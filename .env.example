# ==============================================================================
# SOCIALTUSH ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
DB_HOST=localhost
DB_PORT=5433
POSTGRES_PORT=5433
DB_NAME=socialtush
DB_USER=socialtush_user
DB_PASSWORD=socialtush_secure_pass

# --- CACHE CONFIGURATION (REDIS) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OBJECT STORAGE CONFIGURATION (MINIO / S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=socialtush_minio_admin
MINIO_SECRET_KEY=socialtush_minio_secret
MINIO_BUCKET_NAME=socialtush-media
MINIO_PUBLIC_URL=http://localhost:9000/socialtush-media

# --- SECURITY & JWT ---
JWT_SECRET=super-secure-and-extremely-long-random-string-for-jwt-signing-key-32-bytes-minimum-required
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- APP PORT CONFIGURATION ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- PUSH NOTIFICATIONS ---
FCM_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# Optional one-time production administrator bootstrap. All three are required.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
